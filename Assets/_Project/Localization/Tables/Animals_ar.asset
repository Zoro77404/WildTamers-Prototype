  - m_Id: 411688970
    m_Localized: "\u0627\u0644\u062D\u0635\u0627\u0646 \u0627\u0644\u0639\u0631\u0628\u064A
      \u0627\u0644\u0628\u0631\u064A"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688971
    m_Localized: "\u0633\u0631\u064A\u0639 \u0648\u0634\u062F\u064A\u062F \u0627\u0644\u062A\u062D\u0645\u0644"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688972
    m_Localized: "\u0627\u0644\u062D\u0635\u0627\u0646 \u0627\u0644\u0639\u0631\u0628\u064A
      \u0645\u0646 \u0623\u0642\u062F\u0645 \u0633\u0644\u0627\u0644\u0627\u062A
      \u0627\u0644\u062E\u064A\u0644 \u0641\u064A \u0627\u0644\u0639\u0627\u0644\u0645.
      \u0644\u0647 \u0631\u0623\u0633 \u0635\u063A\u064A\u0631 \u0648\u0648\u062C\u0647
      \u0645\u0642\u0639\u0631 \u0648\u0630\u064A\u0644 \u0645\u0631\u0641\u0648\u0639
      \u0628\u0641\u062E\u0631\u060C \u0648\u064A\u062A\u062D\u0645\u0644 \u0627\u0644\u062C\u0631\u064A
      \u0645\u0633\u0627\u0641\u0627\u062A \u0637\u0648\u064A\u0644\u0629. \u0648\u0647\u0648
      \u0633\u0631\u064A\u0639 \u0648\u0630\u0643\u064A \u0648\u0644\u0637\u064A\u0641
      \u0645\u0639 \u0623\u0635\u062D\u0627\u0628\u0647."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688973
    m_Localized: "\u0627\u0639\u062A\u0646\u0649 \u0627\u0644\u0628\u062F\u0648 \u0641\u064A
      \u0627\u0644\u062C\u0632\u064A\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064A\u0629
      \u0628\u062A\u0631\u0628\u064A\u0629 \u0627\u0644\u062E\u064A\u0644 \u0627\u0644\u0623\u0635\u064A\u0644\u0629
      \u0642\u0631\u0648\u0646\u0627 \u0637\u0648\u064A\u0644\u0629\u060C \u0648\u0643\u0627\u0646\u062A
      \u0627\u0644\u0641\u0631\u0633 \u0639\u0632\u064A\u0632\u0629 \u0639\u0646\u062F\u0647\u0645
      \u0643\u0623\u0646\u0647\u0627 \u0645\u0646 \u0623\u0647\u0644 \u0627\u0644\u0628\u064A\u062A.
      \u0648\u062D\u0645\u0644\u062A \u0627\u0644\u062E\u064A\u0644 \u0641\u0631\u0633\u0627\u0646\u0647\u0627
      \u0641\u064A \u0627\u0644\u0631\u062D\u0644\u0627\u062A \u0627\u0644\u0637\u0648\u064A\u0644\u0629
      \u0648\u0633\u0627\u062D\u0627\u062A \u0627\u0644\u0641\u0631\u0648\u0633\u064A\u0629.
      \u0648\u0627\u0644\u064A\u0648\u0645 \u062A\u062F\u062E\u0644 \u062F\u0645\u0627\u0621
      \u0627\u0644\u062E\u064A\u0644 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u0641\u064A
      \u0633\u0644\u0627\u0644\u0627\u062A \u0643\u062B\u064A\u0631\u0629\u060C \u0641\u062A\u0632\u064A\u062F\u0647\u0627
      \u0633\u0631\u0639\u0629 \u0648\u0642\u0648\u0629."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688974
    m_Localized: "\u0631\u0641\u0633\u0629"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688975
    m_Localized: "\u0627\u0646\u0637\u0644\u0627\u0642\u0629 \u0627\u0644\u0635\u062D\u0631\u0627\u0621"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688976
    m_Localized: "\u0627\u0646\u062F\u0641\u0627\u0639\u0629 \u0645\u062F\u0648\u064A\u0629
      \u0641\u0648\u0642 \u0627\u0644\u0631\u0645\u0627\u0644."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688977
    m_Localized: "\u0635\u0642\u0631"
    m_Metadata:
