  - m_Id: 411688998
    m_Localized: "\u0645\u062A\u064A\u0646 \u0648\u064A\u0642\u0627\u062A\u0644 \u0628\u0642\u0631\u0646\u064A\u0647"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688999
    m_Localized: "\u0627\u0644\u0645\u0647\u0627 \u0627\u0644\u0639\u0631\u0628\u064A
      \u0645\u0646 \u0627\u0644\u0638\u0628\u0627\u0621\u060C \u0644\u0648\u0646\u0647
      \u0623\u0628\u064A\u0636 \u0641\u0627\u062A\u062D \u0648\u0644\u0647 \u0642\u0631\u0646\u0627\u0646
      \u0637\u0648\u064A\u0644\u0627\u0646 \u0645\u0633\u062A\u0642\u064A\u0645\u0627\u0646.
      \u064A\u0639\u0643\u0633 \u0644\u0648\u0646\u0647 \u0627\u0644\u0623\u0628\u064A\u0636
      \u062D\u0631\u0627\u0631\u0629 \u0627\u0644\u0634\u0645\u0633\u060C \u0648\u064A\u0633\u062A\u0637\u064A\u0639
      \u0623\u0646 \u064A\u0639\u064A\u0634 \u0648\u0642\u062A\u0627 \u0637\u0648\u064A\u0644\u0627
      \u062F\u0648\u0646 \u0645\u0627\u0621. \u0648\u062D\u0648\u0627\u0641\u0631\u0647
      \u0627\u0644\u0639\u0631\u064A\u0636\u0629 \u062A\u0633\u0627\u0639\u062F\u0647
      \u0639\u0644\u0649 \u0627\u0644\u0633\u064A\u0631 \u0641\u0648\u0642 \u0627\u0644\u0631\u0645\u0627\u0644
      \u0627\u0644\u0644\u064A\u0646\u0629."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411689000
    m_Localized: "\u0643\u0627\u0646 \u0627\u0644\u0646\u0627\u0633 \u064A\u0635\u0637\u0627\u062F\u0648\u0646
      \u0627\u0644\u0645\u0647\u0627 \u0644\u0623\u062C\u0644 \u0644\u062D\u0645\u0647
      \u0648\u062C\u0644\u062F\u0647\u060C \u062D\u062A\u0649 \u0627\u062E\u062A\u0641\u0649
      \u0645\u0646 \u0627\u0644\u0628\u0631\u064A\u0629 \u0639\u0627\u0645 1972.
      \u062B\u0645 \u0623\u0646\u0642\u0630\u062A\u0647 \u0628\u0631\u0627\u0645\u062C
      \u0627\u0644\u062A\u0643\u0627\u062B\u0631 \u0641\u064A \u0627\u0644\u0623\u0633\u0631\u060C
      \u0641\u0639\u0627\u062F \u0627\u0644\u064A\u0648\u0645 \u0625\u0644\u0649
      \u0645\u062D\u0645\u064A\u0627\u062A \u0627\u0644\u0633\u0639\u0648\u062F\u064A\u0629
      \u0648\u0633\u0644\u0637\u0646\u0629 \u0639\u0645\u0627\u0646. \u0648\u0648\u0635\u0641
      \u0627\u0644\u0634\u0639\u0631\u0627\u0621 \u0639\u064A\u0648\u0646 \u0627\u0644\u062C\u0645\u064A\u0644\u0627\u062A
      \u0628\u0639\u064A\u0648\u0646 \u0627\u0644\u0645\u0647\u0627."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
