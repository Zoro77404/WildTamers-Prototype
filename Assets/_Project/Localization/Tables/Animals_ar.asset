  - m_Id: 411689007
    m_Localized: "\u0631\u0634\u064A\u0642 \u0648\u0633\u0631\u064A\u0639"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411689008
    m_Localized: "\u0627\u0644\u063A\u0632\u0644\u0627\u0646 \u0638\u0628\u0627\u0621
      \u0635\u063A\u064A\u0631\u0629 \u0631\u0634\u064A\u0642\u0629\u060C \u0633\u064A\u0642\u0627\u0646\u0647\u0627
      \u0646\u062D\u064A\u0644\u0629 \u0648\u0642\u0631\u0648\u0646\u0647\u0627 \u0645\u0646\u062D\u0646\u064A\u0629.
      \u062A\u0639\u062F\u0648 \u0628\u0633\u0631\u0639\u0629 \u0643\u0628\u064A\u0631\u0629
      \u0648\u062A\u0642\u0641\u0632 \u0639\u0627\u0644\u064A\u0627 \u0644\u062A\u0646\u062C\u0648
      \u0645\u0646 \u0627\u0644\u062E\u0637\u0631. \u0648\u062A\u0639\u064A\u0634
      \u0641\u064A \u0627\u0644\u0633\u0647\u0648\u0644 \u0627\u0644\u062C\u0627\u0641\u0629
      \u0648\u0627\u0644\u062A\u0644\u0627\u0644 \u0627\u0644\u0635\u062E\u0631\u064A\u0629\u060C
      \u0648\u062A\u0623\u0643\u0644 \u0627\u0644\u0623\u0648\u0631\u0627\u0642 \u0648\u0627\u0644\u0623\u0639\u0634\u0627\u0628."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411689009
    m_Localized: "\u062A\u062A\u0628\u0639 \u0627\u0644\u0635\u064A\u0627\u062F\u0648\u0646
      \u0645\u0646 \u0627\u0644\u0628\u062F\u0648 \u0627\u0644\u063A\u0632\u0644\u0627\u0646
      \u0628\u0627\u0644\u0643\u0644\u0627\u0628 \u0627\u0644\u0633\u0644\u0648\u0642\u064A\u0629
      \u0648\u0627\u0644\u0635\u0642\u0648\u0631\u060C \u0648\u0643\u0627\u0646 \u0644\u062D\u0645\u0647\u0627
      \u0637\u0639\u0627\u0645\u0627 \u0645\u0631\u063A\u0648\u0628\u0627. \u0648\u062A\u063A\u0646\u0649
      \u0627\u0644\u0634\u0639\u0631\u0627\u0621 \u0627\u0644\u0639\u0631\u0628 \u0628\u062C\u0645\u0627\u0644
      \u0627\u0644\u063A\u0632\u0627\u0644 \u0648\u0631\u0634\u0627\u0642\u062A\u0647.
      \u0648\u0627\u0644\u064A\u0648\u0645 \u062A\u062D\u0645\u064A \u0627\u0644\u0645\u062D\u0645\u064A\u0627\u062A
      \u0641\u064A \u0627\u0644\u0633\u0639\u0648\u062F\u064A\u0629 \u0627\u0644\u063A\u0632\u0644\u0627\u0646
      \u0644\u062A\u0628\u0642\u0649 \u0622\u0645\u0646\u0629."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
