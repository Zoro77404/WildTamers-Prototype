      - rid: 8955012208633315441
  - m_Id: 411688979
    m_Localized: "\u0627\u0644\u0635\u0642\u0631 \u0627\u0644\u0628\u0631\u064A"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688980
    m_Localized: "\u0633\u0631\u064A\u0639 \u0648\u0641\u062A\u0627\u0643 \u0644\u0643\u0646\u0647
      \u0647\u0634"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688981
    m_Localized: "\u0627\u0644\u0635\u0642\u0648\u0631 \u0637\u064A\u0648\u0631 \u062C\u0627\u0631\u062D\u0629
      \u0633\u0631\u064A\u0639\u0629\u060C \u062D\u0627\u062F\u0629 \u0627\u0644\u0628\u0635\u0631\u060C
      \u0642\u0648\u064A\u0629 \u0627\u0644\u0645\u062E\u0627\u0644\u0628. \u0648\u064A\u0646\u0642\u0636
      \u0627\u0644\u0635\u0642\u0631 \u0627\u0644\u0634\u0627\u0647\u064A\u0646 \u0645\u0646
      \u0627\u0644\u0623\u0639\u0644\u0649 \u0628\u0633\u0631\u0639\u0629 \u062A\u062A\u062C\u0627\u0648\u0632
      300 \u0643\u064A\u0644\u0648\u0645\u062A\u0631 \u0641\u064A \u0627\u0644\u0633\u0627\u0639\u0629.
      \u0648\u0647\u0630\u0627 \u064A\u062C\u0639\u0644\u0647 \u0623\u0633\u0631\u0639
      \u062D\u064A\u0648\u0627\u0646 \u0641\u064A \u0627\u0644\u0639\u0627\u0644\u0645."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688982
    m_Localized: "\u0627\u0644\u0635\u0642\u0627\u0631\u0629\u060C \u0623\u064A \u0627\u0644\u0635\u064A\u062F
      \u0628\u0627\u0644\u0635\u0642\u0648\u0631 \u0627\u0644\u0645\u062F\u0631\u0628\u0629\u060C
      \u062C\u0632\u0621 \u0645\u0646 \u062D\u064A\u0627\u0629 \u0627\u0644\u0639\u0631\u0628
      \u0645\u0646\u0630 \u0642\u0631\u0648\u0646 \u0637\u0648\u064A\u0644\u0629.
      \u0648\u0643\u0627\u0646 \u0627\u0644\u0628\u062F\u0648 \u064A\u0635\u0637\u0627\u062F\u0648\u0646
      \u0628\u0647\u0627 \u0627\u0644\u0623\u0631\u0627\u0646\u0628 \u0648\u0627\u0644\u062D\u0628\u0627\u0631\u0649
      \u0644\u064A\u062D\u0635\u0644\u0648\u0627 \u0639\u0644\u0649 \u0637\u0639\u0627\u0645
      \u0637\u0627\u0632\u062C \u0644\u0645\u062E\u064A\u0645\u0627\u062A\u0647\u0645.
      \u0648\u0627\u0644\u064A\u0648\u0645 \u062A\u0641\u062E\u0631 \u0627\u0644\u0633\u0639\u0648\u062F\u064A\u0629
      \u0628\u0627\u0644\u0635\u0642\u0627\u0631\u0629\u060C \u0648\u0642\u062F \u0623\u062F\u0631\u062C\u062A\u0647\u0627
      \u0627\u0644\u064A\u0648\u0646\u0633\u0643\u0648 \u0636\u0645\u0646 \u0642\u0627\u0626\u0645\u0629
      \u0627\u0644\u062A\u0631\u0627\u062B \u0627\u0644\u062B\u0642\u0627\u0641\u064A
      \u063A\u064A\u0631 \u0627\u0644\u0645\u0627\u062F\u064A \u0644\u0644\u0625\u0646\u0633\u0627\u0646\u064A\u0629."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688983
    m_Localized: "\u0636\u0631\u0628\u0629 \u0627\u0644\u0645\u062E\u0644\u0628"
    m_Metadata:
