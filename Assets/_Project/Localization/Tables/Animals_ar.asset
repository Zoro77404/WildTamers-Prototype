      - rid: 8955012208633315441
  - m_Id: 411688988
    m_Localized: "\u0627\u0644\u0633\u0644\u0648\u0642\u064A \u0627\u0644\u0628\u0631\u064A"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688989
    m_Localized: "\u0633\u0631\u064A\u0639 \u0627\u0644\u062C\u0631\u064A"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688990
    m_Localized: "\u0627\u0644\u0633\u0644\u0648\u0642\u064A \u0643\u0644\u0628 \u0635\u064A\u062F
      \u0646\u062D\u064A\u0644 \u0637\u0648\u064A\u0644 \u0627\u0644\u0633\u0627\u0642\u064A\u0646
      \u0648\u0641\u0631\u0648\u0647 \u0646\u0627\u0639\u0645 \u0643\u0627\u0644\u062D\u0631\u064A\u0631.
      \u0648\u0647\u0648 \u0645\u0646 \u0623\u0642\u062F\u0645 \u0633\u0644\u0627\u0644\u0627\u062A
      \u0627\u0644\u0643\u0644\u0627\u0628\u060C \u0648\u064A\u062C\u0631\u064A \u0628\u0633\u0631\u0639\u0629
      \u0643\u0628\u064A\u0631\u0629 \u0644\u0645\u0633\u0627\u0641\u0627\u062A \u0637\u0648\u064A\u0644\u0629.
      \u0648\u0639\u064A\u0646\u0627\u0647 \u0627\u0644\u062D\u0646\u0648\u0646\u062A\u0627\u0646
      \u062A\u0645\u0646\u062D\u0627\u0646\u0647 \u0645\u0638\u0647\u0631\u0627 \u0644\u0637\u064A\u0641\u0627
      \u0648\u0647\u0627\u062F\u0626\u0627."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315441
  - m_Id: 411688991
    m_Localized: "\u0631\u0627\u0641\u0642 \u0627\u0644\u0633\u0644\u0648\u0642\u064A
      \u0627\u0644\u0628\u062F\u0648 \u0641\u064A \u0631\u062D\u0644\u0627\u062A
      \u0627\u0644\u0635\u064A\u062F\u060C \u0641\u0643\u0627\u0646 \u064A\u0637\u0627\u0631\u062F
      \u0627\u0644\u063A\u0632\u0644\u0627\u0646 \u0648\u0627\u0644\u0623\u0631\u0627\u0646\u0628
      \u0641\u064A \u0627\u0644\u0635\u062D\u0631\u0627\u0621 \u0627\u0644\u0645\u0641\u062A\u0648\u062D\u0629\u060C
      \u0648\u063A\u0627\u0644\u0628\u0627 \u0645\u0639 \u0627\u0644\u0635\u0642\u0648\u0631.
      \u0648\u0643\u0627\u0646\u0648\u0627 \u064A\u0644\u0642\u0628\u0648\u0646\u0647
      \"\u0627\u0644\u062D\u0631\" \u0644\u0646\u0628\u0644\u0647 \u0648\u0623\u0635\u0627\u0644\u062A\u0647.
      \u0648\u0643\u062B\u064A\u0631 \u0645\u0646 \u0627\u0644\u0642\u0628\u0627\u0626\u0644
      \u0644\u0627 \u062A\u0628\u064A\u0639 \u0643\u0644\u0627\u0628\u0647\u0627
      \u0627\u0644\u0633\u0644\u0648\u0642\u064A\u0629\u060C \u0628\u0644 \u062A\u0647\u062F\u064A\u0647\u0627
      \u0644\u0645\u0646 \u062A\u062D\u0628."
