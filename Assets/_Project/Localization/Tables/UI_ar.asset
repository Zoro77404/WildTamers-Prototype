      - rid: 8955012208633315439
  - m_Id: 1619648590
    m_Localized: "\u0625\u0644\u0649 \u0627\u0644\u0645\u0639\u0631\u0643\u0629:
      {0}!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648591
    m_Localized: "\u0645\u0627\u0630\u0627 \u0633\u064A\u0641\u0639\u0644 <b>{0}</b>\u061F"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648592
    m_Localized: "<b>{0}</b> \u064A\u062A\u062E\u0630 \u0648\u0636\u0639 \u0627\u0644\u062F\u0641\u0627\u0639!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648593
    m_Localized: "<b>{0}</b> \u064A\u0633\u062A\u062E\u062F\u0645 <b>{1}</b>!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648594
    m_Localized: "<b>{0}</b> \u064A\u0633\u062A\u062E\u062F\u0645 <b>{1}</b> \u0639\u0644\u0649
      <b>{2}</b>!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648595
    m_Localized: "<color=#EF476F>\u0636\u0631\u0631 {0}</color>"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648596
    m_Localized: "<color=#FF8A3D>\u0636\u0631\u0628\u0629 \u062D\u0631\u062C\u0629!</color>"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648597
    m_Localized: "<color=#4DA3FF>\u062A\u0645 \u0627\u0644\u0635\u062F:</color>"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648598
    m_Localized: "\u0633\u0642\u0637 <b>{0}</b>!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648599
    m_Localized: "\u064A\u062D\u0627\u0648\u0644 \u0641\u0631\u064A\u0642\u0643 \u0627\u0644\u0647\u0631\u0628\u2026"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648600
    m_Localized: "\u062A\u0645\u0643\u0646 \u0641\u0631\u064A\u0642\u0643 \u0645\u0646
      \u0627\u0644\u0647\u0631\u0628 \u0628\u0633\u0644\u0627\u0645!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648601
    m_Localized: "\u0644\u0645 \u062A\u062A\u0645\u0643\u0646 \u0645\u0646 \u0627\u0644\u0647\u0631\u0628
      \u0645\u0646 <b>{0}</b>!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648602
    m_Localized: "\u0627\u0646\u0636\u0645 <b>{0}</b> \u0625\u0644\u0649 \u0641\u0631\u064A\u0642\u0643!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648603
    m_Localized: "\u062D\u0635\u0644 \u0627\u0644\u062C\u0645\u064A\u0639 \u0639\u0644\u0649
      <b>{0} \u062E\u0628\u0631\u0629</b>!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648604
    m_Localized: "\u0633\u0642\u0637 \u0641\u0631\u064A\u0642\u0643 \u0628\u0627\u0644\u0643\u0627\u0645\u0644\u2026"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648605
    m_Localized: "\u0644\u0627 \u062A\u0648\u062C\u062F \u062D\u064A\u0648\u0627\u0646\u0627\u062A
      \u0644\u0644\u0642\u062A\u0627\u0644."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648606
    m_Localized: "\u0627\u0646\u062A\u0635\u0627\u0631!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648607
    m_Localized: "\u0627\u0646\u0636\u0645 <b>{0}</b> (\u0645\u0633\u062A\u0648\u0649
      {1}) \u0625\u0644\u0649 \u0641\u0631\u064A\u0642\u0643!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648608
    m_Localized: "\u0644\u0642\u062F \u0641\u0632\u062A!"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648609
    m_Localized: "\u064A\u0646\u0627\u0644 \u0643\u0644 \u062D\u064A\u0648\u0627\u0646
      \u0641\u064A \u0641\u0631\u064A\u0642\u0643 {0} \u0646\u0642\u0637\u0629 \u062E\u0628\u0631\u0629."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648610
    m_Localized: "\u0647\u0632\u064A\u0645\u0629\u2026"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648611
    m_Localized: "\u0633\u0642\u0637 \u0641\u0631\u064A\u0642\u0643 \u0628\u0627\u0644\u0643\u0627\u0645\u0644.\n\u0644\u0643\u0646\u0647
      \u0627\u0633\u062A\u0631\u0627\u062D \u0648\u062A\u0639\u0627\u0641\u0649 \u062A\u0645\u0627\u0645\u0627."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648612
    m_Localized: "\u0633\u0642\u0637 <b>{0}</b>.\n\u0648\u0627\u0633\u062A\u0631\u0627\u062D
      \u0641\u0631\u064A\u0642\u0643 \u0648\u062A\u0639\u0627\u0641\u0649 \u062A\u0645\u0627\u0645\u0627."
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648613
    m_Localized: "\u0645\u062A\u0627\u0628\u0639\u0629"
    m_Metadata:
      m_Items:
      - rid: 8955012208633315439
  - m_Id: 1619648614
