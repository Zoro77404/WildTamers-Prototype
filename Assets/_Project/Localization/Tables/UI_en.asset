      m_Items:
      - rid: 8955012208633315440
  - m_Id: 1619648542
    m_Localized: Leave the battle?
    m_Metadata:
      m_Items:
      - rid: 8955012208633315440
  - m_Id: 1619648543
    m_Localized: 'Your team will retreat.

      The wild animal stays where it is.'
