    m_Localized: Save reset. Fresh start!
    m_Metadata:
      m_Items:
      - rid: 8955012208633315440
  - m_Id: 1619648538
    m_Localized: Reset save?
    m_Metadata:
      m_Items:
      - rid: 8955012208633315440
  - m_Id: 1619648539
    m_Localized: 'This deletes all your animals and starts a new game.

      This
      can''t be undone.'
    m_Metadata:
      m_Items:
      - rid: 8955012208633315440
  - m_Id: 1619648540
    m_Localized: Yes, reset
